-- MOBILE TOGGLE BUTTON - Draggable, Animated, Premium
-- ═══════════════════════════════════════════════════════════════

local function CreateMobileToggle()
    local screenGui = Instance.new("ScreenGui")
    screenGui.Name = "MorndMobileToggle"
    screenGui.ResetOnSpawn = false
    screenGui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
    screenGui.DisplayOrder = 999
    
    local success, _ = pcall(function()
        screenGui.Parent = game:GetService("CoreGui")
    end)
    if not success then
        screenGui.Parent = LocalPlayer:WaitForChild("PlayerGui")
    end
    
    MobileToggleGui = screenGui

    -- Outer glow ring
    local glowRing = Instance.new("Frame")
    glowRing.Name = "GlowRing"
    glowRing.Size = UDim2.fromOffset(60, 60)
    glowRing.Position = UDim2.new(1, -75, 0.5, -30)
    glowRing.BackgroundColor3 = Color3.fromRGB(130, 50, 255)
    glowRing.BackgroundTransparency = 0.6
    glowRing.BorderSizePixel = 0
    glowRing.Parent = screenGui

    local glowCorner = Instance.new("UICorner")
    glowCorner.CornerRadius = UDim.new(1, 0)
    glowCorner.Parent = glowRing

    -- Main button
    local toggleBtn = Instance.new("TextButton")
    toggleBtn.Name = "ToggleButton"
    toggleBtn.Size = UDim2.fromOffset(50, 50)
    toggleBtn.Position = UDim2.new(0.5, -25, 0.5, -25)
    toggleBtn.BackgroundColor3 = Color3.fromRGB(25, 25, 35)
    toggleBtn.BorderSizePixel = 0
    toggleBtn.Text = ""
    toggleBtn.AutoButtonColor = false
    toggleBtn.ZIndex = 10
    toggleBtn.Parent = glowRing

    local btnCorner = Instance.new("UICorner")
    btnCorner.CornerRadius = UDim.new(1, 0)
    btnCorner.Parent = toggleBtn

    local btnStroke = Instance.new("UIStroke")
    btnStroke.Color = Color3.fromRGB(130, 50, 255)
    btnStroke.Thickness = 2.5
    btnStroke.Transparency = 0
    btnStroke.Parent = toggleBtn

    -- "M" letter icon
    local iconLabel = Instance.new("TextLabel")
    iconLabel.Name = "Icon"
    iconLabel.Size = UDim2.new(1, 0, 1, 0)
    iconLabel.BackgroundTransparency = 1
    iconLabel.Text = "M"
    iconLabel.TextColor3 = Color3.fromRGB(180, 120, 255)
    iconLabel.TextScaled = true
    iconLabel.Font = Enum.Font.GothamBlack
    iconLabel.ZIndex = 11
    iconLabel.Parent = toggleBtn

    -- Inner padding for the M letter
    local iconPadding = Instance.new("UIPadding")
    iconPadding.PaddingTop = UDim.new(0.15, 0)
    iconPadding.PaddingBottom = UDim.new(0.15, 0)
    iconPadding.PaddingLeft = UDim.new(0.15, 0)
    iconPadding.PaddingRight = UDim.new(0.15, 0)
    iconPadding.Parent = iconLabel

    -- Status dot (green = menu open, red = menu closed)
    local statusDot = Instance.new("Frame")
    statusDot.Name = "StatusDot"
    statusDot.Size = UDim2.fromOffset(12, 12)
    statusDot.Position = UDim2.new(1, -10, 0, -2)
    statusDot.BackgroundColor3 = Color3.fromRGB(255, 60, 60)
    statusDot.BorderSizePixel = 0
    statusDot.ZIndex = 12
    statusDot.Parent = toggleBtn

    local dotCorner = Instance.new("UICorner")
    dotCorner.CornerRadius = UDim.new(1, 0)
    dotCorner.Parent = statusDot

    local dotStroke = Instance.new("UIStroke")
    dotStroke.Color = Color3.fromRGB(25, 25, 35)
    dotStroke.Thickness = 2
    dotStroke.Parent = statusDot

    -- ═══ PULSE ANIMATION ═══
    local pulseUp = true
    task.spawn(function()
        while not Unloaded and glowRing and glowRing.Parent do
            local targetTrans = pulseUp and 0.3 or 0.7
            local tween = TweenService:Create(glowRing, TweenInfo.new(1.2, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut), {
                BackgroundTransparency = targetTrans
            })
            tween:Play()
            tween.Completed:Wait()
            pulseUp = not pulseUp
        end
    end)

    -- ═══ DRAG LOGIC (works on both mobile touch and desktop mouse) ═══
    local dragging = false
    local dragStart = nil
    local startPos = nil
    local dragThreshold = 8
    local wasDragged = false

    toggleBtn.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.Touch or input.UserInputType == Enum.UserInputType.MouseButton1 then
            dragging = true
            wasDragged = false
            dragStart = input.Position
            startPos = glowRing.Position
        end
    end)

    toggleBtn.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.Touch or input.UserInputType == Enum.UserInputType.MouseButton1 then
            dragging = false
        end
    end)

    UserInputService.InputChanged:Connect(function(input)
        if dragging and (input.UserInputType == Enum.UserInputType.Touch or input.UserInputType == Enum.UserInputType.MouseMovement) then
            local delta = input.Position - dragStart
            if delta.Magnitude > dragThreshold then
                wasDragged = true
            end
            local newPos = UDim2.new(
                startPos.X.Scale, startPos.X.Offset + delta.X,
                startPos.Y.Scale, startPos.Y.Offset + delta.Y
            )
            glowRing.Position = newPos
        end
    end)

    -- ═══ TOGGLE CLICK (only if not dragged) ═══
    local menuOpen = true

    toggleBtn.MouseButton1Click:Connect(function()
        if wasDragged then return end
        menuOpen = not menuOpen

        -- Toggle MacLib window
        pcall(function()
            MacLibWindow:Toggle()
        end)

        -- Animate button feedback
        local pressColor = menuOpen and Color3.fromRGB(50, 200, 100) or Color3.fromRGB(255, 60, 60)
        local glowColor = menuOpen and Color3.fromRGB(50, 200, 100) or Color3.fromRGB(130, 50, 255)
        local letterColor = menuOpen and Color3.fromRGB(100, 255, 150) or Color3.fromRGB(180, 120, 255)

        TweenService:Create(statusDot, TweenInfo.new(0.3, Enum.EasingStyle.Quint), {
            BackgroundColor3 = pressColor
        }):Play()

        TweenService:Create(btnStroke, TweenInfo.new(0.3, Enum.EasingStyle.Quint), {
            Color = glowColor
        }):Play()

        TweenService:Create(glowRing, TweenInfo.new(0.3, Enum.EasingStyle.Quint), {
            BackgroundColor3 = glowColor
        }):Play()

        TweenService:Create(iconLabel, TweenInfo.new(0.3, Enum.EasingStyle.Quint), {
            TextColor3 = letterColor
        }):Play()

        -- Button press scale animation
        local scaleDown = TweenService:Create(toggleBtn, TweenInfo.new(0.1, Enum.EasingStyle.Quint), {
            Size = UDim2.fromOffset(42, 42),
            Position = UDim2.new(0.5, -21, 0.5, -21)
        })
        local scaleUp = TweenService:Create(toggleBtn, TweenInfo.new(0.2, Enum.EasingStyle.Back, Enum.EasingDirection.Out), {
            Size = UDim2.fromOffset(50, 50),
            Position = UDim2.new(0.5, -25, 0.5, -25)
        })
        scaleDown:Play()
        scaleDown.Completed:Connect(function()
            scaleUp:Play()
        end)
    end)

    return screenGui
end

-- Create the mobile toggle button (works on ALL platforms)
CreateMobileToggle()
