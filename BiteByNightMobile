    "Oh Yeah", "Mystery", "Jump for Joy", "Join us for a Bite", "Heroic Dance",
    "Hardstyle", "Friendly Stance", "Down", "Clown", "Boat Dance", "A Dare"
}


local halfCount = math.ceil(#emoteList / 2)

for i, emote in ipairs(emoteList) do
    local targetSection = (i <= halfCount) and EmotesLeft or EmotesRight
    targetSection:Button({
        Name = emote,
        Callback = function() PlayEmote(emote) end,
    })
end


