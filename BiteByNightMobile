    Side = "Left",
})

local SettingsRight = SettingsTab:Section({
    Side = "Right",
})


SettingsLeft:Header({ Text = "Menu Toggle" })

SettingsLeft:Paragraph({
    Header = "Toggle Keybind",
    Body = "Default: Right Shift\nChange the key below to customize.\nMobile: Use the floating button.",
})

local keybindOptions = {
    "RightShift", "LeftShift", "RightControl", "LeftControl",
    "RightAlt", "LeftAlt", "F1", "F2", "F3", "F4",
    "F5", "F6", "F7", "F8", "F9", "Home", "End", "Insert"
}

local currentKeybindName = "RightShift"

SettingsLeft:Dropdown({
    Name = "Toggle Key",
    Options = keybindOptions,
    Default = "RightShift",
    Callback = function(selected)
        currentKeybindName = selected
        local keyEnum = Enum.KeyCode[selected]
        if keyEnum then
            MacLibWindow:SetKeybind(keyEnum)
            MacLibWindow:Notify({
                Title = "Settings",
                Description = "Toggle key changed to: " .. selected,
                Lifetime = 3,
            })
        end
    end,
}, "ToggleKeybindDropdown")


